{
    "name": "manishnlet77/laravel-youtube",
    "description": "A production-ready, open-source Laravel Composer package for integrating a public YouTube channel using only its handle.",
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0|^12.0",
        "illuminate/console": "^10.0|^11.0|^12.0",
        "illuminate/http": "^10.0|^11.0|^12.0",
        "illuminate/cache": "^10.0|^11.0|^12.0"
    },
    "require-dev": {
        "orchestra/testbench": "^8.0|^9.0",
        "phpunit/phpunit": "^10.0"
    },
    "autoload": {
        "psr-4": {
            "Manishnlet77\\LaravelYouTube\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Manishnlet77\\LaravelYouTube\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Manishnlet77\\LaravelYouTube\\LaravelYouTubeServiceProvider"
            ],
            "aliases": {
                "YouTube": "Manishnlet77\\LaravelYouTube\\Facades\\YouTube"
            }
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
